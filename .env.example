# ==============================================================================
# PayBridge AI — Authoritative Environment Configuration Template
# ==============================================================================
# Rule: Copy this file to .env for local development. Never commit .env to git.
# Rule: Startup config validator fails if required keys are missing or invalid.
# Rule: PAYPAL_ENV must equal 'sandbox'. Live credentials will abort startup.
# ==============================================================================

# Core Application Runtime
APP_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173

# Data Persistence & Caching
DATABASE_URL=postgres://paybridge_admin:paybridge_dev_secret@localhost:5432/paybridge_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography (Never commit real values)
# SESSION_SECRET: Used for signing HttpOnly session cookies (minimum 32 characters)
SESSION_SECRET=dev_session_secret_change_in_production_min32chars
# ENCRYPTION_KEY: 256-bit AES-GCM hex key for sensitive evidence payload encryption (64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PayPal REST API Configuration (Sandbox ONLY)
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=__SET_PAYPAL_SANDBOX_CLIENT_ID__
PAYPAL_CLIENT_SECRET=__SET_PAYPAL_SANDBOX_CLIENT_SECRET__
PAYPAL_WEBHOOK_ID=__SET_PAYPAL_SANDBOX_WEBHOOK_ID__

# Hosted LLM Provider Integration
# Supported providers: anthropic, openai, gemini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=__SET_LLM_API_KEY__
LLM_ENABLED=true
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.0

# Telemetry & Logging
LOG_LEVEL=debug
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Local Simulation & Fault Invariants (Development Only)
ENABLE_LOCAL_SIMULATOR=true
FAULT_PROXY_ENABLED=false
